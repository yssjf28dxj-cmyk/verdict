rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ─── HELPERS ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isDebateParticipantByData(data) {
      return isSignedIn()
        && (
          request.auth.uid == data.fighter1
          || request.auth.uid == data.fighter2
          || request.auth.uid == data.creatorId
          || request.auth.uid == data.invitedUserId
          || (data.invitedUserIds is list && data.invitedUserIds.hasAny([request.auth.uid]))
        );
    }

    function isPublicDebateByData(data) {
      return !(data.visibilityMode is string) || data.visibilityMode == 'public';
    }

    function canReadDebateByData(data) {
      return isPublicDebateByData(data)
        || (data.visibilityMode == 'request_only' && isSignedIn())
        || isDebateParticipantByData(data);
    }

    function onlyChangedKeys(allowedKeys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedKeys);
    }

    function onlyFields(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    // ─── VALIDATION HELPERS ─────────────────────────────────
    function validCreationMode(mode) {
      return mode == 'public_feed' || mode == 'direct_invite';
    }

    function validVisibilityMode(mode) {
      return mode == 'public' || mode == 'request_only' || mode == 'private';
    }

    function validLanguage(code) {
      return code == 'ru' || code == 'en' || code == 'ar';
    }

    function validRegion(code) {
      return code == 'global' || code == 'cis' || code == 'mena' || code == 'europe_africa';
    }

    function validRounds(v) {
      return v == 1 || v == 3 || v == 5;
    }

    function validDuration(v) {
      return v == 30 || v == 60 || v == 90 || v == 120 || v == 180 || v == 300 || v == 420 || v == 600;
    }

    // ─── USERS ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'avatarUrl', 'displayName'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rank', 'isBanned', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'avatarUrl', 'displayName', 'rank', 'isBanned', 'settings', 'lastSeen', 'stats']);

      allow delete: if false;
    }

    // ─── LOBBIES (strict field control) ─────────────────────
    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;

      // Only allowed fields can change, per role
      allow update: if isSignedIn()
        && (
          // Creator can update lobby settings
          (request.auth.uid == resource.data.creatorId
            && onlyChangedKeys(['status', 'opponentId', 'opponentName', 'debateId',
              'creatorReady', 'opponentReady', 'creatorDuration', 'opponentDuration',
              'creatorRounds', 'opponentRounds', 'settings']))
          ||
          // Opponent can set their fields
          (request.auth.uid == resource.data.opponentId
            && onlyChangedKeys(['opponentReady', 'opponentDuration', 'opponentRounds',
              'opponentName', 'status']))
        );

      allow delete: if false;
    }

    // ─── WORLD MESSAGES (read only, write via Cloud Function) ───
    match /world_messages/{messageId} {
      allow read: if isSignedIn();
      // All writes go through sendWorldMessage Cloud Function
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── DEBATES ────────────────────────────────────────────
    match /debates/{debateId} {
      allow get: if canReadDebateByData(resource.data);
      allow list: if isSignedIn();

      // Strict client-side creation with full schema validation
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.fighter1 == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 3
        && request.resource.data.topic.size() <= 200
        && request.resource.data.durationSeconds is int
        && request.resource.data.roundDurationSeconds is int
        && validDuration(request.resource.data.durationSeconds)
        && request.resource.data.roundDurationSeconds == request.resource.data.durationSeconds
        && request.resource.data.roundIndex == 1
        && request.resource.data.currentRound == 1
        && request.resource.data.votes1 == 0
        && request.resource.data.votes2 == 0
        && request.resource.data.viewerCount == 0
        && validRounds(request.resource.data.totalRounds)
        && validCreationMode(request.resource.data.creationMode)
        && validVisibilityMode(request.resource.data.visibilityMode)
        && validLanguage(request.resource.data.languageCode)
        && validRegion(request.resource.data.region)
        && request.resource.data.accessRequests is list
        && request.resource.data.accessApprovedUserIds is list
        && request.resource.data.accessApprovedUserIds.hasAny([request.auth.uid])
        && (request.resource.data.creationMode != 'direct_invite'
          || (request.resource.data.invitedUserId is string && request.resource.data.invitedUserId.size() > 0));

      // Only specific update patterns allowed
      allow update: if
        // Accept invite
        (isSignedIn()
          && resource.data.status == 'waiting'
          && request.auth.uid == resource.data.invitedUserId
          && onlyChangedKeys(['fighter2', 'fighter2Name', 'status', 'isRoundActive',
            'activeSpeakerId', 'roundEndsAt', 'acceptedAt',
            'accessApprovedUserIds', 'accessRequests', 'roundIndex', 'currentRound'])
          && request.resource.data.fighter2 == request.auth.uid
          && request.resource.data.status == 'active'
          && request.resource.data.isRoundActive == true
          && request.resource.data.accessApprovedUserIds is list
          && request.resource.data.accessApprovedUserIds.hasAny([request.auth.uid])
          && request.resource.data.fighter1 == resource.data.fighter1
          && request.resource.data.creatorId == resource.data.creatorId)
        ||
        // Request access (request_only debates)
        (isSignedIn()
          && resource.data.visibilityMode == 'request_only'
          && onlyChangedKeys(['accessRequests'])
          && request.resource.data.accessRequests is list
          && request.resource.data.accessRequests.hasAny([request.auth.uid]))
        ||
        // Moderate access requests (creator only)
        (isSignedIn()
          && resource.data.visibilityMode == 'request_only'
          && request.auth.uid == resource.data.creatorId
          && onlyChangedKeys(['accessRequests', 'accessApprovedUserIds'])
          && request.resource.data.accessRequests is list
          && request.resource.data.accessApprovedUserIds is list);

      // Only creator can cancel, only before start
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.creatorId
        && resource.data.status == 'waiting';

      // Messages: only via Cloud Functions
      match /messages/{messageId} {
        allow read: if canReadDebateByData(
          get(/databases/$(database)/documents/debates/$(debateId)).data);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      // Votes: completely server-side
      match /votes/{voteId} {
        allow read: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── ADMIN COLLECTIONS (server-only) ────────────────────
    match /admin_migration_access/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /admin_migration_access_audit/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /core_runtime_flags/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /core_metrics/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /core_events/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /migration_runs/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /migration_lock/{doc} {
      allow read: if false;
      allow write: if false;
    }

    // ─── DEFAULT DENY: catch unknown collections ────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
