rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ─── HELPERS ────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function accountMayWrite() {
      return isSignedIn()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true);
    }

    function isDebateParticipantByData(data) {
      return isSignedIn()
        && (
          request.auth.uid == data.get('fighter1', '')
          || request.auth.uid == data.get('fighter2', '')
          || request.auth.uid == data.get('creatorId', '')
          || request.auth.uid == data.get('invitedUserId', '')
          || data.get('invitedUserIds', []).hasAny([request.auth.uid])
        );
    }

    function isPublicDebateByData(data) {
      return !(data.get('visibilityMode', 'public') is string)
        || data.get('visibilityMode', 'public') == 'public';
    }

    function canReadDebateByData(data) {
      return isPublicDebateByData(data)
        || (data.visibilityMode == 'request_only' && isSignedIn())
        || isDebateParticipantByData(data);
    }

    function canReadDebateMessagesByData(data) {
      return isPublicDebateByData(data)
        || isDebateParticipantByData(data)
        || (data.visibilityMode == 'request_only'
          && isSignedIn()
          && data.get('accessApprovedUserIds', []) is list
          && data.get('accessApprovedUserIds', []).hasAny([request.auth.uid]));
    }

    function onlyChangedKeys(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function onlyFields(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    // ─── VALIDATION HELPERS ─────────────────────────────────
    function validCreationMode(mode) {
      return mode == 'public_feed' || mode == 'direct_invite';
    }

    function validVisibilityMode(mode) {
      return mode == 'public' || mode == 'request_only' || mode == 'private';
    }

    function validLanguage(code) {
      return code == 'ru' || code == 'en' || code == 'ar';
    }

    function validRegion(code) {
      return code == 'global' || code == 'cis' || code == 'mena' || code == 'europe_africa';
    }

    function validRounds(v) {
      return v == 1 || v == 3 || v == 5;
    }

    function validDuration(v) {
      return v == 30 || v == 60 || v == 90 || v == 120 || v == 180 || v == 300 || v == 420 || v == 600;
    }

    // ─── USERS ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'avatarUrl', 'displayName'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;

      // Only editable public/profile preferences may change. All present and
      // future server fields (rank, stats, flat rating/wins, publicId, etc.)
      // remain immutable, even when a legacy user document contains them.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && onlyChangedKeys(['name', 'email', 'avatarUrl', 'displayName', 'settings', 'lastSeen'])
        // Email belongs to Firebase Authentication, not a public profile.
        // Owners may remove a legacy copy, but never add or replace it.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
          || !('email' in request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
          || (request.resource.data.name is string && request.resource.data.name.size() <= 50));

      allow delete: if false;

      // Private references only: saving never grants access to the battle.
      match /saved_debates/{debateId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if accountMayWrite() && request.auth.uid == uid
          && debateId.matches('^[A-Za-z0-9_-]{1,128}$')
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt == request.time
          && exists(/databases/$(database)/documents/debates/$(debateId))
          && get(/databases/$(database)/documents/debates/$(debateId)).data.status == 'finished'
          && canReadDebateByData(get(/databases/$(database)/documents/debates/$(debateId)).data);
      }
    }

    // ─── LEGACY LOBBIES (server-only archive) ───────────────
    // The routed LobbyScreen uses debates/{id} and validated callables.
    // The unused LobbyService's former collection has no supported client
    // workflow. Keep old invitation records private instead of retaining an
    // unvalidated parallel lifecycle with a conflicting schema.
    match /lobbies/{lobbyId} {
      allow read, write: if false;
    }

    // ─── WORLD MESSAGES (read only, write via Cloud Function) ───
    match /world_messages/{messageId} {
      allow read: if isSignedIn();
      // All writes go through sendWorldMessage Cloud Function
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ─── DEBATES ────────────────────────────────────────────
    match /debates/{debateId} {
      allow get: if canReadDebateByData(resource.data);
      allow list: if isSignedIn()
        && (isDebateParticipantByData(resource.data)
          || resource.data.get('visibilityMode', '') in ['public', 'request_only']);

      // Lifecycle changes go through validated, transactional Cloud Functions.
      // Clients cannot inject deadlines, AI results or profileStatsApplied at create.
      allow create: if false;

      allow update: if
        // Request access (request_only debates)
        (accountMayWrite()
          && resource.data.visibilityMode == 'request_only'
          && onlyChangedKeys(['accessRequests'])
          && request.resource.data.accessRequests is list
          && resource.data.get('accessRequests', []) is list
          && request.resource.data.accessRequests.hasAll(resource.data.get('accessRequests', []))
          && request.resource.data.accessRequests.toSet()
            .difference(resource.data.get('accessRequests', []).toSet()).hasOnly([request.auth.uid])
          && request.resource.data.accessRequests.size() <= resource.data.get('accessRequests', []).size()
            + (resource.data.get('accessRequests', []).hasAny([request.auth.uid]) ? 0 : 1)
          && request.resource.data.accessRequests.hasAny([request.auth.uid]))
        ||
        // Moderate access requests (creator only)
        (accountMayWrite()
          && resource.data.visibilityMode == 'request_only'
          && request.auth.uid == resource.data.creatorId
          && onlyChangedKeys(['accessRequests', 'accessApprovedUserIds'])
          && request.resource.data.accessRequests is list
          && request.resource.data.accessApprovedUserIds is list);

      // Cancellation is checked on the server against concurrent acceptance.
      allow delete: if false;

      // Messages: only via Cloud Functions
      match /messages/{messageId} {
        allow read: if canReadDebateMessagesByData(
          get(/databases/$(database)/documents/debates/$(debateId)).data);
        allow create: if false;
        allow update: if false;
        allow delete: if false;

        // Counts follow transcript access. Individual choices belong to their
        // owner, and no client may write counters or another spectator's state.
        match /reaction_tallies/{shardId} {
          allow read: if exists(/databases/$(database)/documents/debates/$(debateId)/messages/$(messageId))
            && canReadDebateMessagesByData(get(/databases/$(database)/documents/debates/$(debateId)).data);
          allow write: if false;
        }
        match /reactions/{uid} {
          allow read: if isSignedIn() && request.auth.uid == uid
            && exists(/databases/$(database)/documents/debates/$(debateId)/messages/$(messageId))
            && canReadDebateMessagesByData(get(/databases/$(database)/documents/debates/$(debateId)).data);
          allow write: if false;
        }
      }

      // Ephemeral typing/recording status: only the current fighter may
      // publish activity, and a fighter may always clear their own status.
      match /activity/{uid} {
        function parent() { return get(/databases/$(database)/documents/debates/$(debateId)).data; }
        allow read: if canReadDebateMessagesByData(parent());
        allow create, update: if accountMayWrite() && request.auth.uid == uid
          && (uid == parent().get('fighter1', '') || uid == parent().get('fighter2', ''))
          && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.status == ''
            || (parent().status in ['active', 'live'] && parent().activeSpeakerId == uid
              && request.time < parent().roundEndsAt
              && request.resource.data.status in ['typing', 'recording', 'voice', 'image']));
        allow delete: if false;
      }

      // Viewer-facing AI reasoning follows the transcript's access boundary.
      // A request-only debate card is discoverable before access is approved,
      // but its transcript and judgement are not.
      match /private_state/{stateId} {
        allow read: if canReadDebateMessagesByData(
          get(/databases/$(database)/documents/debates/$(debateId)).data);
        allow write: if false;
      }

      // Aggregate shards contain counts only; individual ballots stay private.
      match /vote_tallies/{shardId} {
        allow read: if canReadDebateMessagesByData(
          get(/databases/$(database)/documents/debates/$(debateId)).data);
        allow write: if false;
      }

      // Votes: completely server-side
      match /votes/{voteId} {
        allow read: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── ADMIN COLLECTIONS (server-only) ────────────────────
    match /admin_migration_access/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /admin_migration_access_audit/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /core_runtime_flags/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /core_metrics/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /core_events/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /migration_runs/{doc} {
      allow read: if false;
      allow write: if false;
    }

    match /migration_lock/{doc} {
      allow read: if false;
      allow write: if false;
    }

    // ─── DEFAULT DENY: catch unknown collections ────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
