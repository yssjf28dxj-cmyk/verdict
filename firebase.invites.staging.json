{
  "hosting": {
    "site": "verdict-test-1471f",
    "public": "web/invitations",
    "ignore": ["**/node_modules/**"],
    "rewrites": [{ "source": "/invite/**", "destination": "/index.html" }],
    "headers": [
      { "source": "**", "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ] },
      { "source": "/.well-known/assetlinks.json", "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ] }
    ]
  }
}
