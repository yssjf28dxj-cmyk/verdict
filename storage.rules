rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── HELPER ────────────────────────────────────────────────────────────
    // Cross-service check: only active debate participants (fighter1, fighter2,
    // or the creator) may upload media to a debate folder.
    // firestore.get() is available in Storage Rules v2.
    function isDebateParticipant(debateId) {
      let debate = firestore.get(
        /databases/(default)/documents/debates/$(debateId)
      ).data;
      return request.auth != null
        && (
          debate.fighter1 == request.auth.uid
          || debate.fighter2 == request.auth.uid
          || debate.creatorId == request.auth.uid
        );
    }

    // ─── DEBATE MEDIA ───────────────────────────────────────────────────────
    // Path: debates/{debateId}/media/{fileName}
    //
    // READ  — any authenticated user (viewers must be able to load images/audio)
    // WRITE — debate participants only, ≤ 10 MB, image/* or audio/* only
    // DELETE — never (immutable evidence; deletion only via admin SDK)
    match /debates/{debateId}/media/{fileName} {
      allow read: if request.auth != null;

      allow write: if isDebateParticipant(debateId)
        && request.resource.size < 10 * 1024 * 1024   // 10 MB hard cap
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
        );

      allow delete: if false;
    }

    // ─── DEFAULT DENY ───────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
